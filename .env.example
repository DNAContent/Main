# Copy this file to .env and fill in your values for local development/testing

# ── Pipedrive (Integration 1: Facebook Lead Ads → Pipedrive) ─────────────────
# Create an app at: https://pipedrive.readme.io/docs/marketplace-oauth-authorization
PIPEDRIVE_CLIENT_ID=your_pipedrive_client_id_here
PIPEDRIVE_CLIENT_SECRET=your_pipedrive_client_secret_here

# For local testing with zapier-platform-core you can also set:
# ACCESS_TOKEN=your_pipedrive_access_token

# ── Slack (Integration 2: Slack → Monday.com Task Board) ─────────────────────
# Create a Slack app at https://api.slack.com/apps
# Required Bot Token Scopes: channels:history, channels:read
# After installing the app to your workspace, copy the Bot User OAuth Token (xoxb-...)
# and invite the bot to the channel you want to monitor.
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token-here

# ── Monday.com (Integration 2: Slack / Cross-board → Nicky's Task Board) ─────
# Find your API token under: Profile picture → Developers → API → My Access Tokens
MONDAY_API_KEY=your_monday_api_v2_token_here

# Monday.com Board IDs (find in the board URL: monday.com/boards/XXXXXXXXXX)
MONDAY_NICKY_TASK_BOARD_ID=your_nicky_task_board_id_here
MONDAY_DISTRIBUTION_STUDIO_BOARD_ID=your_distribution_studio_board_id_here

# Nicky's Monday.com user ID (Admin → Users → click Nicky → ID is in the URL)
MONDAY_NICKY_USER_ID=your_nicky_monday_user_id_here
